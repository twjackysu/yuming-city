; Engine configuration file.
; 這些詛咒對我太有用了 These Curses Are Far Too Useful to Me — Godot 4.7.2-stable（版本固定於 scripts/get-godot.sh）

config_version=5

[application]

config/name="These Curses Are Far Too Useful to Me"
config/name_localized={
"en": "These Curses Are Far Too Useful to Me",
"zh_TW": "這些詛咒對我太有用了"
}
config/description="An anime-style action RPG where every curse turns into a boon."
config/version="0.0.1"
config/use_custom_user_dir=true
config/custom_user_dir_name="CursesTooUseful"
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.03, 0.035, 0.05, 1)
boot_splash/show_image=false

[autoload]

App="*res://autoload/app.gd"
Settings="*res://autoload/settings.gd"
Game="*res://autoload/game.gd"
Perf="*res://autoload/perf.gd"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_call_argument=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/return_value_discarded=0
gdscript/warnings/integer_division=1
gdscript/warnings/narrowing_conversion=1
gdscript/warnings/shadowed_variable=1
gdscript/warnings/unused_parameter=1
gdscript/warnings/unreachable_code=2
gdscript/warnings/standalone_expression=2

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[internationalization]

locale/translations=PackedStringArray("res://i18n/strings.en.translation", "res://i18n/strings.zh_TW.translation")
locale/fallback="en"

[rendering]

renderer/rendering_method="forward_plus"
rendering_device/driver.windows="d3d12"
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.03, 0.035, 0.05, 1)
reflections/reflection_atlas/reflection_count=8
