; Engine configuration file.
; 餘命城 Yuming City — Godot 4.7.2-stable（版本固定於 scripts/get-godot.sh）

config_version=5

[application]

config/name="Yuming City"
config/name_localized={
"en": "Yuming City",
"zh_TW": "餘命城"
}
config/description="A chapter-based narrative action RPG."
config/version="0.0.1"
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.03, 0.035, 0.05, 1)
boot_splash/show_image=false

[autoload]

App="*res://autoload/app.gd"
Settings="*res://autoload/settings.gd"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_call_argument=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/return_value_discarded=0
gdscript/warnings/integer_division=1
gdscript/warnings/narrowing_conversion=1
gdscript/warnings/shadowed_variable=1
gdscript/warnings/unused_parameter=1
gdscript/warnings/unreachable_code=2
gdscript/warnings/standalone_expression=2

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[internationalization]

locale/translations=PackedStringArray("res://i18n/strings.en.translation", "res://i18n/strings.zh_TW.translation", "res://i18n/slice.en.translation", "res://i18n/slice.zh_TW.translation")
locale/fallback="en"

[rendering]

renderer/rendering_method="forward_plus"
rendering_device/driver.windows="d3d12"
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.03, 0.035, 0.05, 1)
