{
  "id": "rb_main",
  "title": "Q_RB_MAIN_TITLE",
  "stages": [
    {
      "id": "escape",
      "objective": "Q_RB_OBJ_ESCAPE",
      "checkpoint": "rb_start",
      "marker": "node:RbNorthCorner",
      "done_when": {"flag": "rb.barrels_broken"}
    },
    {
      "id": "poison_discovery",
      "objective": "Q_RB_OBJ_MIST",
      "checkpoint": "rb_before_mist",
      "marker": "node:RbSouthGate",
      "marker_if": [
        {"when": {"all": [{"flag": "rb.reversal_awakened"}, {"not": {"flag": "rb.mist_reentered"}}]}, "marker": "node:RbMistEdge"}
      ],
      "objective_if": [
        {"when": {"all": [{"flag": "rb.reversal_awakened"}, {"not": {"flag": "rb.mist_reentered"}}]}, "objective": "Q_RB_OBJ_MIST_TEST"}
      ],
      "done_when": {"all": [{"flag": "rb.reversal_awakened"}, {"flag": "rb.mist_reentered"}, {"flag": "rb.reached_south"}]}
    },
    {
      "id": "meet_sheila",
      "objective": "Q_RB_OBJ_SHEILA",
      "checkpoint": "rb_sheila",
      "marker": "node:Sheila",
      "done_when": {"flag": "rb.sheila_met"}
    },
    {
      "id": "guardian_fight",
      "objective": "Q_RB_OBJ_GUARDIAN",
      "checkpoint": "rb_guardian",
      "marker": "node:RbGuardian",
      "marker_if": [{"when": {"flag": "rb.guardian_down"}, "marker": "node:Sheila"}],
      "done_when": {"all": [{"flag": "rb.guardian_down"}, {"flag": "rb.guardian_talked"}]}
    },
    {
      "id": "portable_poison",
      "objective": "Q_RB_OBJ_POTION",
      "checkpoint": "rb_portable",
      "marker": "node:RbPotionCrate",
      "marker_if": [{"when": {"flag": "rb.potion_found"}, "marker": "node:Sheila"}],
      "done_when": {"all": [{"flag": "rb.potion_found"}, {"any": [{"flag": "rb.potion_tried"}, {"flag": "rb.potion_kept"}]}, {"flag": "rb.potion_talked"}]}
    },
    {
      "id": "market_lead",
      "objective": "Q_RB_OBJ_MARKET",
      "checkpoint": "rb_market",
      "marker": "node:PearSellerTrigger",
      "marker_if": [{"when": {"flag": "rb.ada_talked"}, "marker": "node:CellarTrigger"}],
      "done_when": {"flag": "rb.market_reached"}
    }
  ],
  "on_complete": {"set": {"rb.first_ten_done": true}, "start_quest": ["rb_market"]}
}
