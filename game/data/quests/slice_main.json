{
  "id": "slice_main",
  "title": "Q_SLICE_MAIN_TITLE",
  "stages": [
    {
      "id": "explore_town",
      "objective": "Q_SLICE_OBJ_TOWN",
      "checkpoint": "start",
      "done_when": {"flag": "slice.met_pear_seller"}
    },
    {
      "id": "ring_bell",
      "objective": "Q_SLICE_OBJ_BELL",
      "checkpoint": "bell_tower",
      "done_when": {"flag": "slice.bell_rings", "gte": 9},
      "on_done": {"set": {"slice.north_street_collapsed": true}}
    },
    {
      "id": "rescue",
      "objective": "Q_SLICE_OBJ_RESCUE",
      "checkpoint": "rescue",
      "done_when": {"any": [{"flag": "slice.rescue_done"}, {"flag": "slice.rescued_count", "gte": 3}]}
    },
    {
      "id": "meet_sheila",
      "objective": "Q_SLICE_OBJ_SHEILA",
      "checkpoint": "sheila_meet",
      "done_when": {"all": [{"flag": "slice.sheila_talked"}, {"flag": "slice.ashwalker_defeated"}]}
    },
    {
      "id": "escort_convoy",
      "objective": "Q_SLICE_OBJ_CONVOY",
      "checkpoint": "undertaker",
      "done_when": {"flag": "slice.convoy_through"}
    },
    {
      "id": "aftermath",
      "objective": "Q_SLICE_OBJ_CELLAR",
      "checkpoint": "aftermath",
      "done_when": {"flag": "slice.cellar_entered"}
    }
  ],
  "on_complete": {"set": {"slice.complete": true}}
}
