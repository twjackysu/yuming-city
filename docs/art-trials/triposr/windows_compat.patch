@@ -6 +6,8 @@ import torch.nn as nn
-from torchmcubes import marching_cubes
+try:
+    from torchmcubes import marching_cubes
+except ImportError:
+    from skimage.measure import marching_cubes as cpu_marching_cubes
+    def marching_cubes(level, threshold):
+        vertices, faces, _, _ = cpu_marching_cubes(level.detach().cpu().numpy(), level=threshold)
+        # Match torchmcubes' coordinate order; caller swaps it back below.
+        return torch.from_numpy(vertices[:, [2, 1, 0]].copy()), torch.from_numpy(faces.astype(np.int64).copy())
